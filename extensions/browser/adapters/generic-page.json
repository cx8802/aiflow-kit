{
  "id": "generic-page",
  "displayName": "通用页面",
  "description": "在当前页面执行用户触发的提取和受控 DOM 动作。",
  "matches": [
    "activeTab"
  ],
  "capabilities": [
    "read_page",
    "extract",
    "click",
    "fill"
  ],
  "actions": [
    {
      "id": "extract",
      "label": "提取文本",
      "requiresSelector": false,
      "usesValue": false
    },
    {
      "id": "click",
      "label": "点击选择器",
      "requiresSelector": true,
      "usesValue": false
    },
    {
      "id": "fill",
      "label": "填入选择器",
      "requiresSelector": true,
      "usesValue": true
    }
  ]
}
