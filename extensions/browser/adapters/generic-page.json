{
  "id": "generic-page",
  "displayName": "Generic page",
  "description": "Runs backend-queued extraction and DOM actions in the active browser tab.",
  "matches": [
    "activeTab"
  ],
  "capabilities": [
    "read_page",
    "snapshot",
    "extract",
    "click",
    "fill",
    "scroll"
  ],
  "actions": [
    {
      "id": "snapshot",
      "label": "Snapshot page",
      "requiresSelector": false,
      "usesValue": false
    },
    {
      "id": "extract",
      "label": "Extract text",
      "requiresSelector": false,
      "usesValue": false
    },
    {
      "id": "click",
      "label": "Click selector",
      "requiresSelector": true,
      "usesValue": false
    },
    {
      "id": "fill",
      "label": "Fill selector",
      "requiresSelector": true,
      "usesValue": true
    },
    {
      "id": "scroll",
      "label": "Scroll page",
      "requiresSelector": false,
      "usesValue": true
    }
  ]
}
