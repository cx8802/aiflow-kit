{
  "manifest_version": 3,
  "name": "AIFlow 浏览器助手",
  "version": "0.1.0",
  "description": "打开独立配置页，并在 DevTools 面板读取当前选中的页面元素交给本地 aiflow 后端。",
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 AIFlow 配置页"
  },
  "options_page": "settings.html",
  "devtools_page": "devtools.html"
}
